# Node environment: development | test | production
NODE_ENV=development

# Database configuration
DB_HOST=yourdb-host                # The hostname or IP address of your PostgreSQL database server eg localhost
DB_PORT=5432                       # The port number on which PostgreSQL is listening (default is 5432)
DB_USER=your-database-username     # The username used to connect to the PostgreSQL database
DB_PASSWORD=your-database-password # The password for the PostgreSQL database user
DB_NAME=your-database-name         # The name of the PostgreSQL database you are connecting to eg. shortlet_db
DB_SSL=false                       # Set to true when connecting to a hosted Postgres that requires SSL (e.g. RDS, Heroku)
DB_POOL_MAX=10                     # Max number of pooled DB connections per app instance
DB_POOL_MIN=2                      # Min number of pooled DB connections kept warm per app instance

# JSON Web Token (JWT) configuration
JWT_SECRET_KEY=your-secret-key     # The secret key used to sign and verify JWT tokens
JWT_EXPIRES_IN=1h                  # The expiration time for JWT tokens (e.g., 1h for one hour, 7d for seven days)

# Server configuration
PORT=8080                          # The port number on which your Node.js application will run (default is 8080)

# API configuration
API_URL=https://restcountries.com/v3.1  # The base URL for the REST Countries API (used only by the /api/migrate job)

# Redis configuration
REDIS_URL=redis://localhost:6379   # The URL of your Redis instance (including the protocol and port)

# Logging
LOG_LEVEL=info                     # Winston log level: error | warn | info | debug
